# Optional CLI configuration. GUI users can save these values in Settings.
# Copy to .unfairplayed.env and replace the placeholders for this Mac.
TEAM_ID=YOURTEAMID
# Fixed helper ID. Existing installations keep their previously configured ID.
UNFAIRPLAYED_BUNDLE_ID=dev.unfairplayed.helper
# Leave empty to detect a single connected physical iPhone or iPad.
DEVICE=
SKIP_TRUST_PROMPT=0
# Signing options: xcode:<Team ID> or imported:<ID shown by backend status>.
HELPER_SIGNER_ID=
DEBUG_SIGNER_ID=
DEBUG_BUNDLE_MODE=helper
DEBUG_CUSTOM_BUNDLE_ID=
AUTO_DEBUG=0
DEBUG_ENABLED=1
DEBUG_FRIDA=1
# Empty selects Conda base first, then a local Frida if Conda is not installed.
FRIDA_PATH=
FRIDA_MODE=attach
# attach reuses a running process; launch restarts suspended before attaching.
LLDB_MODE=attach
# Custom dylib injection into the installation copy, before signing.
INJECTION_ENABLED=0
INJECTION_DYLIBS=[]
INJECTION_SUBSTRATE=1
# modern: built-in Hook runtime arm64 only; legacy: original arm64 + arm64e.
INJECTION_COMPATIBILITY=modern
